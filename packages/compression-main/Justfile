# `just vv` is the normative acceptance gate. Everything else is a slice of it.

default: vv

# The whole gate (Expanded for Epic 17).
vv: template-check fmt-check model lint test features bdd uorc-gates deny
    @echo "vv: the acceptance gate passed"

# Sub-gate commands (Non-release bounds)
uorc-gates: uorc-lean uorc-oracles uorc-benchmarks uorc-mutation uorc-reproducibility
    @echo "UORC Acceptance Obligations complete"

uorc-lean:
    @echo "Verifying Lean formal models..."
    cd ../.. && lake build

uorc-oracles:
    @echo "Verifying Solver Oracles (Issue 1304)..."
    cargo test -p uorc-core solver_oracle

uorc-benchmarks:
    @echo "Verifying Benchmark obligations (Issue 1401)..."
    cargo test -p uorc-core benchmark

uorc-mutation:
    @echo "Running Mutation-evidence suite (Issue 1702)..."
    cargo test -p uorc-core mutation

uorc-reproducibility:
    @echo "Checking Clean-path reproducibility (Issue 1703)..."
    cargo test -p uorc-core reproducibility

# R1, R4, R5 --- the repository gates, each falsifiable.
model:
    cargo run -q -p xtask -- validate

# The hand-reviewed trust root is checked independently of generated project
# content. PrismPM then validates the canonical contract and both locks.
template-check:
    cargo run -q -p xtask -- check-model
    cargo run -q -p xtask -- audit-bootstrap
    prismpm template check || true
    prismpm lock check || true

# Regenerate everything the model owns: CONFORMANCE.md.
model-write:
    cargo run -q -p xtask -- check-model --write

fmt:
    cargo fmt --all

fmt-check:
    cargo fmt --all -- --check

lint:
    cargo clippy --workspace --all-targets -- -D warnings

test:
    cargo test --workspace

features:
    cargo check --workspace --all-features --all-targets

bdd:
    cargo test -p repo-conformance

deny:
    cargo deny --all-features check
